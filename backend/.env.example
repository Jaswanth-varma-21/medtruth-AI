# Copy this file to ".env" in the same folder (backend/.env). It is read automatically at start-up.
# THIS IS WHERE THE API KEY GOES: the LLM_API_KEY line below.

# --- Ollama running locally in WSL (free, no real key needed) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=ollama

# Seconds to wait for the model (raise on a slow CPU-only machine)
LLM_TIMEOUT=180

# --- Hosted provider instead (example: Groq). Replace the three lines above with: ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=<model name from the provider's docs>
# LLM_API_KEY=<your real secret key>
